{
  "name": "sat-trainer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "generate": "tsx --env-file-if-exists=.env.local scripts/generate.ts",
    "bank": "tsx --env-file-if-exists=.env.local scripts/bank.ts",
    "db:generate": "drizzle-kit generate",
    "import": "tsx --env-file-if-exists=.env.local scripts/import.ts",
    "check:questions": "tsx scripts/check-questions.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.3",
    "katex": "^0.16.47",
    "mathjs": "^15.2.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
