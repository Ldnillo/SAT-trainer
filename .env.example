# Claude API key used by the question generator (npm run generate).
ANTHROPIC_API_KEY=

# Postgres connection string for production (Neon, Supabase, Vercel Postgres...).
# Leave unset in development to use the embedded database in .data/pglite.
DATABASE_URL=

# Optional overrides for the generator.
# SAT_GENERATOR_MODEL=claude-opus-5-5
# SAT_GENERATOR_EFFORT=high

# Show the internal /bank preview page in production builds.
# ENABLE_BANK_PREVIEW=true

# Accounts (comma-separated emails) that can open /admin/reports to read the problems
# students report on questions. Unset: every account in development, none in production.
# ADMIN_EMAILS=you@example.com

# Season pass payments (Stripe). Use test-mode keys (sk_test_...) until you're ready
# to take real payments. Without STRIPE_SECRET_KEY the buy button is disabled.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at /api/stripe/webhook
# (or the one printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`).
STRIPE_WEBHOOK_SECRET=
# Public address of the site, used for the return links from Stripe Checkout.
# Optional: worked out from the request when unset.
# APP_URL=https://your-site.example

# Season pass terms. Defaults: $39 for 90 days, 1 free practice set and no free
# full-length practice tests before paying.
# SEASON_PASS_PRICE_CENTS=3900
# SEASON_PASS_CURRENCY=usd
# SEASON_PASS_DAYS=90
# FREE_PRACTICE_SETS=1
# FREE_PRACTICE_TESTS=0

# Emails (password reset links and "your password changed" notices), sent through
# Resend (resend.com, free tier). Without a key, emails are printed in the terminal
# running `npm run dev` instead, so you can test password reset locally.
# EMAIL_FROM must use a domain you've verified in Resend.
RESEND_API_KEY=
# EMAIL_FROM="NextScore <hello@your-domain.example>"

# Business details shown in the privacy policy, terms and footer. Until they're set,
# those pages show [bracketed placeholders].
# SUPPORT_EMAIL=support@your-domain.example
# LEGAL_OPERATOR_NAME="Your Name or Company LLC"
# LEGAL_GOVERNING_STATE=California

# Graphing calculator on math questions. Leave unset to use NextScore's built-in
# calculator. With a Desmos API key (desmos.com/my-api; a paid commercial plan is
# needed for a paid site), the Desmos calculator the real SAT uses is shown instead.
# DESMOS_API_KEY=

# Passes get a receipt when bought and a reminder 7 days before they end. The reminder
# runs from /api/cron/pass-reminders once a day (vercel.json sets this up on Vercel).
# Set CRON_SECRET to any long random string; the scheduler sends it as a bearer token.
# CRON_SECRET=
