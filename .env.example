# Claude API key used by the question generator (npm run generate).
ANTHROPIC_API_KEY=

# Postgres connection string for production (Neon, Supabase, Vercel Postgres...).
# Leave unset in development to use the embedded database in .data/pglite.
DATABASE_URL=

# Optional overrides for the generator.
# SAT_GENERATOR_MODEL=claude-opus-5-5
# SAT_GENERATOR_EFFORT=high

# Show the internal /bank preview page in production builds.
# ENABLE_BANK_PREVIEW=true
